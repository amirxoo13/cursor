# =============================================================================
# متغیرهای محیطی پلتفرم پرسش‌وپاسخ قوانین مهاجرتی
# این فایل را کپی کن به .env.local و مقادیر واقعی را جایگزین کن.
# =============================================================================

# --- پایگاه داده (Neon Postgres + pgvector) ---------------------------------
# از Vercel Marketplace یک دیتابیس Neon بساز، یا مستقیم در neon.tech.
# باید extension "vector" روی این دیتابیس فعال باشد (در db/migrations/001_init.sql
# با CREATE EXTENSION IF NOT EXISTS vector انجام می‌شود).
# فرمت: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Hugging Face Inference API (برای embedding) ----------------------------
# از https://huggingface.co/settings/tokens یک توکن با دسترسی "Read" (یا
# "Inference") بساز. مدل embedding چندزبانه‌ی BAAI/bge-m3 استفاده می‌شود که
# فارسی را هم پشتیبانی می‌کند.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# اختیاری — می‌توانی مدل embedding دیگری جایگزین کنی (باید 1024 بعدی باشد یا
# ستون embedding در migration را متناسب تغییر بده)
HF_EMBEDDING_MODEL=BAAI/bge-m3

# --- Qwen3.8-Max API (برای تولید پاسخ نهایی) --------------------------------
# کلید API را از کنسول Alibaba Cloud Model Studio / DashScope بگیر:
# https://dashscope.console.aliyun.com/  (یا نسخه‌ی بین‌المللی)
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# اختیاری — Base URL سازگار با OpenAI برای DashScope. اگر اکانت بین‌المللی
# داری از dashscope-intl استفاده کن، اگر چین داری از dashscope.aliyuncs.com
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# اختیاری — شناسه دقیق مدل روی حساب شما (نام مدل ممکن است بسته به دسترسی
# حساب متفاوت باشد، مثلا qwen3-max یا qwen-max)
QWEN_MODEL=qwen3-max

# --- CourtListener API (اختیاری ولی توصیه‌شده) ------------------------------
# بدون توکن هم کار می‌کند اما با rate limit پایین‌تر. توکن رایگان از
# https://www.courtlistener.com/help/api/rest/ بگیر.
COURTLISTENER_TOKEN=

# --- eCFR / Federal Register / EUR-Lex --------------------------------------
# این سه منبع کلید نمی‌خواهند و به‌صورت عمومی در دسترس‌اند.
